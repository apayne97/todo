<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps the todo server running whenever you're logged in, so it's always
  reachable at http://localhost:4444 (desktop) and over Tailscale from your phone.

  Install (replace YOU in the paths below with your macOS username first):
    cp deploy/com.apayne.todo.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.apayne.todo.plist

  Stop / remove:
    launchctl bootout gui/$(id -u)/com.apayne.todo
    rm ~/Library/LaunchAgents/com.apayne.todo.plist

  Restart after editing the server:
    launchctl kickstart -k gui/$(id -u)/com.apayne.todo

  Task data is a separate repo — clone it alongside this one:
    git clone git@github.com:<you>/todo-data.git ~/life/todo-data

  Logs: ~/life/todo/server.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.apayne.todo</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>server.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOU/life/todo</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- ground truth lives in its own repo (<you>/todo-data) -->
    <key>TODO_FILE</key>
    <string>/Users/YOU/life/todo-data/todos.md</string>
    <key>TODO_AUTOPUSH</key>
    <string>1</string>
    <!-- this is the work Mac -> the app's location filter starts on @work.
         home Mac uses "home". Remove to start unfiltered. -->
    <key>TODO_LOCATION</key>
    <string>work</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOU/life/todo/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/life/todo/server.log</string>
</dict>
</plist>
