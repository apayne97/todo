<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps the todo server running whenever you're logged in, so it's always
  reachable at http://localhost:4444 (desktop) and over Tailscale from your phone.

  Install:
    cp deploy/com.apayne.todo.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.apayne.todo.plist

  Stop / remove:
    launchctl bootout gui/$(id -u)/com.apayne.todo
    rm ~/Library/LaunchAgents/com.apayne.todo.plist

  Restart after editing the server:
    launchctl kickstart -k gui/$(id -u)/com.apayne.todo

  Logs: ~/life/todo/server.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.apayne.todo</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>server.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/apayne/life/todo</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TODO_AUTOPUSH</key>
    <string>1</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/apayne/life/todo/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/apayne/life/todo/server.log</string>
</dict>
</plist>
